# Point this domain at your Linux server; allow TCP 80/443 through its firewall.
WISP_DOMAIN=science.example.com
# Generate with `openssl rand -hex 16` or `wisp-server --generate-code`.
WISP_SERVER_CODE=
WISP_PROVIDER=openai
WISP_API_URL=https://api.openai.com/v1
WISP_MODEL=
WISP_API_KEY=
# Leave empty for exact model IDs in the baked models.dev catalog.
# Unknown/custom models must specify both limits explicitly.
WISP_MAX_CONTEXT=
WISP_MAX_TOKENS=
