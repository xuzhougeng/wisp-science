<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets/RichPreview/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../LICENSES/Apache-2.0.txt" Link="Assets/RichPreview/pdf.LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../ui/vendor-src/katex*;../../../ui/vendor-src/KaTeX*;../../../ui/vendor-src/pdf*.mjs">
      <Link>Assets/RichPreview/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets/Terminal/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../ui/vendor-src/office-preview-runtime.mjs;../../../ui/vendor-src/docx-preview.*;../../../ui/vendor-src/pptx-preview.mjs;../../../ui/vendor-src/pptx-renderer.LICENSE;../../../ui/vendor-src/xlsx*;../../../ui/vendor-src/sheetjs.LICENSE;../../../ui/vendor-src/jszip.LICENSE;../../../ui/vendor-src/office-build.json;../../../ui/vendor-src/pdf*.mjs">
      <Link>Assets/RichPreview/vendor-runtime/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../../ui/vendor-src/office-chunks/*.mjs">
      <Link>Assets/RichPreview/vendor-runtime/office-chunks/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../../ui/vendor-src/scientific-preview.*;../../../ui/vendor-src/structure-preview.*;../../../ui/vendor-src/alignment-preview.*;../../../ui/vendor-src/rdkit-worker.mjs;../../../ui/vendor-src/RDKit*;../../../ui/vendor-src/3Dmol*;../../../ui/vendor-src/nightingale*;../../../ui/vendor-src/rdkit.LICENSE;../../../ui/vendor-src/3dmol.LICENSE;../../../ui/vendor-src/vendor-BoUatD0H.js">
      <Link>Assets/RichPreview/vendor-runtime/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../../ui/vendor-src/xterm*">
      <Link>Assets/Terminal/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <ProjectReference Include="../Wisp.ProjectBrowser/Wisp.ProjectBrowser.csproj" />
    <Content Include="../../macos/Sources/WispProjectBrowserUI/Resources/*">
      <Link>Assets/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
